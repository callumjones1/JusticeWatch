# Database
# Omit entirely for local dev -- backend/etl/db.py defaults to a local
# SQLite file (backend/data/db/justice_watch.db). Set this in production
# (e.g. Render's dashboard) to the Neon connection string.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/justice_watch?sslmode=require

# CORS -- comma-separated. Vite dev server proxies /api so this rarely
# matters locally; production needs the real domain(s).
CORS_ORIGINS=http://localhost:3000,https://justicewatchnetwork.org,https://www.justicewatchnetwork.org
